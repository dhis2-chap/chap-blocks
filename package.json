{
  "name": "chap-blocks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @chap-blocks/reference dev",
    "build": "pnpm --filter \"./apps/*\" -r build",
    "preview": "pnpm --filter @chap-blocks/reference preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages apps api deploy",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "dev:blocks": "pnpm --filter @chap-blocks/demo dev",
    "api:generate": "node scripts/generate-api.mjs",
    "dev:signals": "pnpm --filter @chap-blocks/signals dev",
    "dev:data": "pnpm --filter @chap-blocks/data-checker dev",
    "build:site": "pnpm build && node scripts/assemble-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.12.0",
    "globals": "^16.1.0",
    "openapi-typescript-codegen": "0.29.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^6.4.5",
    "vitest": "^4.0.16"
  }
}
